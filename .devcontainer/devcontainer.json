{
    "name": "SPECK",
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "remoteUser": "debian",
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "mounts": [
        "source=claude-config,target=/home/debian/.claude,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/debian/.claude",
        "DISABLE_AUTOUPDATER": "1"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "sumneko.lua"
            ],
            "settings": {
                "[lua]": {
                    "editor.formatOnSave": true
                },
                "[markdown]": {
                    "editor.wordWrap": "wordWrapColumn",
                    "editor.wordWrapColumn": 100,
                    "editor.wrappingIndent": "deepIndent",
                    "editor.quickSuggestions": {
                        "comments": "off",
                        "strings": "off",
                        "other": "off"
                    }
                }
            }
        }
    }
}
