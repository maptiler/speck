{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Pikchr extension",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/vscode-pikchr"
            },
            "problemMatcher": {
                "base": "$tsc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/vscode-pikchr"
                ]
            },
            "group": "build"
        }
    ]
}
